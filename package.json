{
  "name": "bull-stud-genetics-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Bull Stud Genetics Intelligence Platform — Phase 1: Historical Genetic Proof Database",
  "scripts": {
    "db:generate": "prisma generate",
    "migrate:new": "prisma migrate dev",
    "migrate:demo": "dotenv -e .env.demo -- prisma migrate deploy",
    "migrate:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "db:push:demo": "dotenv -e .env.demo -- prisma db push",
    "db:push:prod": "dotenv -e .env.production -- prisma db push",
    "import:cdcb:dry": "tsx --conditions=react-server prisma/import-cdcb.ts",
    "import:cdcb:prod": "dotenv -e .env.production -- tsx --conditions=react-server prisma/import-cdcb.ts",
    "rollback:demo": "dotenv -e .env.demo -- tsx prisma/compute-rollback.ts",
    "rollback:prod": "dotenv -e .env.production -- tsx prisma/compute-rollback.ts",
    "seed:config:demo": "dotenv -e .env.demo -- tsx prisma/seed-config.ts",
    "seed:config:prod": "dotenv -e .env.production -- tsx prisma/seed-config.ts",
    "seed:demo": "dotenv -e .env.demo -- tsx prisma/seed-demo.ts",
    "import:all": "tsx --conditions=react-server prisma/import-all-bulls.ts",
    "import:cdn": "tsx --conditions=react-server prisma/import-cdn.ts",
    "backfill:codes": "tsx --conditions=react-server prisma/backfill-codes.ts",
    "import:holstein:demo": "dotenv -e .env.demo -- tsx --conditions=react-server prisma/import-holstein.ts",
    "import:holstein:prod": "dotenv -e .env.production -- tsx --conditions=react-server prisma/import-holstein.ts",
    "setup:demo": "npm run db:generate && npm run migrate:demo && npm run seed:config:demo && npm run seed:demo",
    "setup:prod": "npm run db:generate && npm run migrate:prod && npm run seed:config:prod",
    "reset:demo": "dotenv -e .env.demo -- prisma migrate reset --force --skip-generate && npm run seed:config:demo && npm run seed:demo",
    "dev:demo": "dotenv -e .env.demo -- next dev -p 3000",
    "dev:verify": "dotenv -e .env.production -- next dev -p 3199",
    "dev:prod": "dotenv -e .env.production -- next dev -p 3100",
    "build": "prisma generate && next build",
    "start:demo": "dotenv -e .env.demo -- next start -p 3000",
    "start:prod": "dotenv -e .env.production -- next start -p 3100",
    "lint": "next lint",
    "test:unit": "tsx --conditions=react-server --test src/lib/*.test.ts src/lib/us-cdcb/*.test.ts",
    "test:agent": "dotenv -e .env.production -- tsx --test src/lib/agent/agent.test.ts",
    "test:reports": "dotenv -e .env.production -- tsx --test src/lib/proof-change.test.ts src/lib/proof-forecast.test.ts src/lib/proof-similarity.test.ts src/lib/mating-score.test.ts src/lib/mating-targets.test.ts src/lib/relatedness.test.ts src/lib/report-html.test.ts",
    "test:holstein": "tsx --test src/lib/holstein-parse.test.ts",
    "test:layout": "tsx --conditions=react-server --test src/lib/lactanet-layout.test.ts",
    "test:direction": "dotenv -e .env.demo -- tsx --conditions=react-server --test src/lib/us-cdcb/trait-direction.test.ts src/lib/us-cdcb/linear.test.ts",
    "test:components": "tsx --tsconfig tsconfig.test.json --test src/components/LinearGraph.test.tsx",
    "us:finish": "dotenv -e .env.production -- prisma db push --accept-data-loss && dotenv -e .env.production -- tsx --conditions=react-server prisma/import-cdcb.ts ./imports/cdcb && dotenv -e .env.production -- tsx --conditions=react-server prisma/pending/verify-split.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed-config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@prisma/client": "5.22.0",
    "@react-pdf/renderer": "^3.4.5",
    "exceljs": "^4.4.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "^0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "dotenv-cli": "7.4.2",
    "postcss": "8.4.39",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.6",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  }
}
