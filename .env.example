# Copy this to .env.demo and .env.production and adjust as needed.
# NEVER commit .env.demo or .env.production — they are in .gitignore.

# APP_ENV controls the banner label AND the seed guard.
#   demo        -> "DEMO ENVIRONMENT" banner; demo seed allowed
#   production  -> "PRODUCTION ENVIRONMENT" banner; demo seed BLOCKED
APP_ENV=production

# --- Database ---------------------------------------------------------------
# The schema declares provider = "postgresql", so DATABASE_URL must be a
# postgres:// URL in EVERY environment, including demo.
#
# Supabase gives you three connection strings. Which one you want depends on
# where the app runs:
#
#   Session pooler     ...pooler.supabase.com:5432   long-lived server (a VM,
#                                                    a container, `next start`)
#   Transaction pooler ...pooler.supabase.com:6543   serverless / Vercel — every
#                                                    lambda holds its own pool
#   Direct             db.<ref>.supabase.co:5432     IPv6 only; unreachable from
#                                                    most networks. Avoid.
#
# On a long-lived server:
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
#
# On Vercel or any serverless host, use the transaction pooler and add pgbouncer:
# DATABASE_URL="postgresql://USER:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Caps Prisma's connection pool. Supabase's session pooler allows 15 clients per
# project TOTAL; Prisma's default is (cpus * 2 + 1), which can exceed that on its
# own. src/lib/db.ts applies 5 when this is unset.
#   long-lived server  -> 5
#   serverless/Vercel  -> 1   (each warm lambda keeps its own pool)
DB_CONNECTION_LIMIT=5

# --- Security ---------------------------------------------------------------
# Signs the login session cookie. MUST be long, random, and different per
# environment. Rotating it logs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# --- File storage -----------------------------------------------------------
# Where uploaded source files are written.
#
# WARNING: on a serverless host (Vercel) the filesystem is read-only apart from
# /tmp, and /tmp does not survive between requests. Uploaded FILES will not
# persist there — the database records about them will. See docs/DEPLOY.md.
UPLOAD_DIR="./uploads"

# Where the CDN/Lactanet proof CSVs are staged for the bulk importer.
IMPORTS_DIR="./imports"
