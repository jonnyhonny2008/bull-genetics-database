# @anthropic-ai/sdk declares an OPTIONAL peer on zod ^3.25.0 || ^4.0.0, while this
# project pins zod 3.23.8. npm 7+ treats that as a hard ERESOLVE failure, so a plain
# `npm install` exits 1 — which is exactly how the first Vercel build broke.
#
# The peer is optional and nothing here passes zod schemas to the Anthropic SDK, so
# the legacy (npm 6) resolution is correct rather than merely convenient: it installs
# the same tree that the local build and test suites were verified against.
#
# Remove this once zod is moved to ^3.25.0 (or later) and the conflict disappears.
legacy-peer-deps=true
